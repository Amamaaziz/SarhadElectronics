# Sarhad Electrics Backend Environment Variables

PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Connection Strings
# Transaction connection pooler (Session / Transaction mode port 6543 or direct port 5432)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# JWT Secret for User and Admin Authentication
JWT_SECRET="sarhad_electrics_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# Cloudinary Setup for Product Image Uploads
CLOUDINARY_CLOUD_NAME="sarhad-electrics"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Frontend URLs for CORS
FRONTEND_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

